#!/usr/bin/env bash
# description: Initialize Zsh and set as default shell

set -euo pipefail

zsh_path="$(command -v zsh || true)"
if [[ -z "$zsh_path" ]]; then
  echo "zsh is not installed; skipping shell change" >&2
  exit 1
fi

current_shell="$(getent passwd "$USER" | cut -d: -f7)"
if [[ "$current_shell" != "$zsh_path" ]]; then
  chsh -s "$zsh_path"
  echo "Login shell changed to zsh (takes effect on next login)."
fi

mkdir -pv "${XDG_CACHE_HOME:-$HOME/.cache}/zsh" "${XDG_STATE_HOME:-$HOME/.local/state}/zsh"
pkill -u "$USER" zsh --signal=USR1 || true
