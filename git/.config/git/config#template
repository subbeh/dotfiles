# vi: ft=gitconfig

[user]
  email = git@sbbh.cloud
  name = Steven Terwindt
  username = subbeh
  signingkey = {{ index .Vars.gpgKeys 0 }}

[sendemail]
  from = Steven Terwindt <steven@sbbh.cloud>

{{- if eq .Profile "work" }}
[includeIf "gitdir:{{ .Vars.workspaceDir }}/jamf/"]
	path = config-work.inc
{{- end }}

[credential]
  helper = cache

[url "git@github.com:"]
  insteadOf = https://github.com/

[core]
  excludesFile = ~/.config/git/gitignore
  attributesFile = ~/.config/git/gitattributes

[init]
  defaultBranch = main

[push]
  autoSetupRemote = true
  followTags = true

[pull]
  rebase = true

[merge]
  tool = nvimdiff
  ff = only

[diff]
  tool = nvimdiff
  colorMoved = default
  colorMovedWS = allow-indentation-change

[difftool]
  prompt = true
[difftool "nvimdiff"]
  cmd = nvim -d \"$LOCAL\" \"$REMOTE\"

[diff "age"]
  textconv = age --decrypt --identity ~/.config/statemate/key.txt

