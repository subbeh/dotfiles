# vi: ft=gitconfig

[user]
  email = git@sbbh.cloud
  name = Steven Terwindt
  username = subbeh
  signingkey = {{ index .Vars.gpgKeys 0 }}

[sendemail]
  from = Steven Terwindt <steven@sbbh.cloud>

{{- if eq .Profile "work" }}
[includeIf "gitdir:{{ .Vars.workspaceDir }}/jamf/"]
	path = config-work.inc
{{- end }}

[credential]
  helper = cache

[url "git@github.com:"]
  insteadOf = https://github.com/

[core]
  excludesFile = ~/.config/git/gitignore

[init]
  defaultBranch = main

[push]
  autoSetupRemote = true
  followTags = true

[pull]
  rebase = true

[merge]
  ff = only
  tool = nvimdiff
