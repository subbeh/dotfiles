#!/usr/bin/env bash
# description: Apply macOS system settings (Dock, Finder, keyboard, trackpad, power)

# Best-effort by design: a single rejected `defaults write` must not abort the
# rest of the run, so no `set -e`. Failures are collected and reported at the end.
set -uo pipefail

workspace_dir="{{ .Vars.workspaceDir }}"
workspace_dir="${workspace_dir/#\~/$HOME}"

# Pinned Dock apps, in order. Missing ones are skipped.
dock_apps="kitty
Firefox
Microsoft Outlook
Slack
Spotify"

# domain|key|type|value   ('-g' is NSGlobalDomain)
settings=$(
  cat <<EOF
# ── Appearance & global UI ──
-g|AppleInterfaceStyle|string|Dark
-g|AppleShowAllExtensions|bool|true
-g|AppleWindowTabbingMode|string|always
-g|NSTableViewDefaultSizeMode|int|1
-g|NSAutomaticWindowAnimationsEnabled|bool|false
-g|NSWindowResizeTime|float|0.001

# ── Region & units (language/locale left to Setup Assistant / MDM) ──
-g|AppleICUForce24HourTime|bool|true
-g|AppleMeasurementUnits|string|Centimeters
-g|AppleMetricUnits|bool|true
-g|AppleTemperatureUnit|string|Celsius

# ── Keyboard & text ──
-g|InitialKeyRepeat|int|30
-g|KeyRepeat|int|2
-g|NSAutomaticCapitalizationEnabled|bool|false
-g|NSAutomaticPeriodSubstitutionEnabled|bool|false
-g|NSAutomaticSpellingCorrectionEnabled|bool|false
-g|NSAutomaticQuoteSubstitutionEnabled|bool|false
-g|NSAutomaticDashSubstitutionEnabled|bool|false
com.apple.HIToolbox|AppleFnUsageType|int|0

# ── Pointing devices ──
-g|com.apple.swipescrolldirection|bool|false
-g|AppleEnableSwipeNavigateWithScrolls|bool|false
-g|com.apple.mouse.scaling|float|2
-g|com.apple.springing.enabled|bool|true
-g|com.apple.springing.delay|float|0.5
-g|com.apple.mouse.tapBehavior|int|1
-g|com.apple.trackpad.enableSecondaryClick|bool|true
com.apple.AppleMultitouchTrackpad|Clicking|bool|true
com.apple.AppleMultitouchTrackpad|Dragging|bool|false
com.apple.AppleMultitouchTrackpad|TrackpadThreeFingerDrag|bool|false
com.apple.AppleMultitouchTrackpad|TrackpadThreeFingerTapGesture|int|0
com.apple.AppleMultitouchTrackpad|TrackpadRightClick|bool|true
com.apple.AppleMultitouchTrackpad|TrackpadCornerSecondaryClick|int|0

# ── Dock ──
com.apple.dock|tilesize|int|34
com.apple.dock|orientation|string|bottom
com.apple.dock|autohide|bool|false
com.apple.dock|autohide-delay|float|0
com.apple.dock|autohide-time-modifier|float|0
com.apple.dock|show-recents|bool|false
com.apple.dock|show-process-indicators|bool|true
com.apple.dock|minimize-to-application|bool|true
com.apple.dock|mru-spaces|bool|false
# corner value 1 == disabled; kills the stock bottom-right Quick Note
com.apple.dock|wvous-tl-corner|int|1
com.apple.dock|wvous-tl-modifier|int|0
com.apple.dock|wvous-tr-corner|int|1
com.apple.dock|wvous-tr-modifier|int|0
com.apple.dock|wvous-bl-corner|int|1
com.apple.dock|wvous-bl-modifier|int|0
com.apple.dock|wvous-br-corner|int|1
com.apple.dock|wvous-br-modifier|int|0

# ── Stage Manager & window tiling ──
com.apple.WindowManager|GloballyEnabled|bool|false
com.apple.WindowManager|AutoHide|bool|false
com.apple.WindowManager|HideDesktop|bool|true
com.apple.WindowManager|EnableStandardClickToShowDesktop|bool|false
com.apple.WindowManager|EnableTilingByEdgeDrag|bool|false
com.apple.WindowManager|EnableTopTilingByEdgeDrag|bool|false
com.apple.WindowManager|EnableTiledWindowMargins|bool|false
com.apple.WindowManager|EnableTilingOptionAccelerator|bool|true
com.apple.WindowManager|AppWindowGroupingBehavior|int|1

# ── Finder ──
com.apple.finder|ShowPathbar|bool|true
com.apple.finder|ShowStatusBar|bool|true
com.apple.finder|ShowSidebar|bool|true
# Nlsv == list view; SCcf == search the current folder, not the whole Mac
com.apple.finder|FXPreferredViewStyle|string|Nlsv
com.apple.finder|FXDefaultSearchScope|string|SCcf
com.apple.finder|FXEnableExtensionChangeWarning|bool|false
com.apple.finder|WarnOnEmptyTrash|bool|false
com.apple.finder|AppleShowAllFiles|bool|true
com.apple.finder|_FXSortFoldersFirst|bool|true
com.apple.finder|_FXSortFoldersFirstOnDesktop|bool|true
# PfLo == open new windows in the folder named by NewWindowTargetPath
com.apple.finder|NewWindowTarget|string|PfLo
com.apple.finder|NewWindowTargetPath|string|file://${workspace_dir}/
com.apple.finder|ShowHardDrivesOnDesktop|bool|true
com.apple.finder|ShowExternalHardDrivesOnDesktop|bool|true
com.apple.finder|ShowRemovableMediaOnDesktop|bool|true
com.apple.desktopservices|DSDontWriteNetworkStores|bool|true
com.apple.desktopservices|DSDontWriteUSBStores|bool|true

# ── Menu bar clock: "Tue 18 Aug 15:44" ──
# ShowDate 1 == always (0 only shows it when the menu bar has room)
com.apple.menuextra.clock|ShowDate|int|1
com.apple.menuextra.clock|ShowDayOfWeek|bool|true
com.apple.menuextra.clock|ShowAMPM|bool|false

# ── Screenshots ──
com.apple.screencapture|location|string|/tmp
com.apple.screencapture|style|string|selection
com.apple.screencapture|showsCursor|bool|true
com.apple.screencapture|captureDelay|int|0
EOF
)

# Switch to Desktop 1-5 (ctrl+1..5). Disabled so the chords reach tmux/kitty.
# id:keycode -- keycodes are for the digits 1,2,3,4,5; 262144 == control.
space_hotkeys="118:18
119:19
120:20
121:21
122:23"

pam_sudo_local=/etc/pam.d/sudo_local
symbolichotkeys_domain=com.apple.symbolichotkeys

# Apply steps only warn; the verify pass below is the authority on what stuck.
failures=()

warn() {
  echo "  WARN: $1" >&2
}

fail() {
  failures+=("$1")
}

# ─────────────────────────────── apply ───────────────────────────────

apply_defaults() {
  local domain key type value
  echo "Writing defaults..."
  while IFS='|' read -r domain key type value; do
    [[ -z "$domain" || "$domain" == \#* ]] && continue
    defaults write "$domain" "$key" "-$type" "$value" 2>/dev/null ||
      warn "defaults write $domain $key"
  done <<<"$settings"
}

apply_dock_apps() {
  local app path
  echo "Rebuilding Dock..."
  defaults delete com.apple.dock persistent-apps 2>/dev/null || true
  while IFS= read -r app; do
    [[ -z "$app" ]] && continue
    path="/Applications/$app.app"
    if [[ ! -d "$path" ]]; then
      echo "  skipping $app (not installed)"
      continue
    fi
    defaults write com.apple.dock persistent-apps -array-add \
      "<dict><key>tile-data</key><dict><key>file-data</key><dict>
         <key>_CFURLString</key><string>file:///Applications/${app// /%20}.app/</string>
         <key>_CFURLStringType</key><integer>15</integer>
       </dict></dict></dict>" 2>/dev/null ||
      warn "pinning $app to the Dock"
  done <<<"$dock_apps"
}

apply_space_hotkeys() {
  local id keycode
  echo "Disabling ctrl+1..5 space switching..."
  while IFS=: read -r id keycode; do
    [[ -z "$id" ]] && continue
    defaults write "$symbolichotkeys_domain" AppleSymbolicHotKeys -dict-add "$id" \
      "<dict><key>enabled</key><false/>
         <key>value</key><dict>
           <key>type</key><string>standard</string>
           <key>parameters</key><array>
             <integer>65535</integer><integer>$keycode</integer><integer>262144</integer>
           </array>
         </dict>
       </dict>" 2>/dev/null ||
      warn "disabling symbolic hotkey $id"
  done <<<"$space_hotkeys"
}

apply_touchid_sudo() {
  echo "Enabling TouchID for sudo..."
  if sudo grep -q pam_tid "$pam_sudo_local" 2>/dev/null; then
    echo "  already enabled"
    return
  fi
  printf 'auth       sufficient     pam_tid.so\n' |
    sudo tee -a "$pam_sudo_local" >/dev/null ||
    warn "adding pam_tid to $pam_sudo_local"
}

apply_power() {
  echo "Applying power settings..."
  sudo pmset -a displaysleep 30 disksleep 10 powernap 1 ||
    warn "pmset displaysleep/disksleep/powernap"
  # Unsupported on some Apple Silicon laptops; not worth failing over.
  sudo pmset -a womp 0 2>/dev/null || true
}

# ─────────────────────────────── verify ───────────────────────────────

# Read-back value a successful write should produce.
expected_read() {
  local type=$1 value=$2
  if [[ "$type" == bool ]]; then
    case "$value" in true | yes | 1) echo 1 ;; *) echo 0 ;; esac
  else
    echo "$value"
  fi
}

verify_defaults() {
  local domain key type value actual want
  while IFS='|' read -r domain key type value; do
    [[ -z "$domain" || "$domain" == \#* ]] && continue
    actual=$(defaults read "$domain" "$key" 2>/dev/null)
    want=$(expected_read "$type" "$value")
    if [[ "$type" == float ]]; then
      awk -v a="$actual" -v b="$want" 'BEGIN { exit !(a + 0 == b + 0) }' && continue
    elif [[ "$actual" == "$want" ]]; then
      continue
    fi
    fail "$domain $key is '$actual', expected '$want'"
  done <<<"$settings"
}

verify_dock_apps() {
  local app want=0 actual
  while IFS= read -r app; do
    [[ -n "$app" && -d "/Applications/$app.app" ]] && ((want += 1))
  done <<<"$dock_apps"

  actual=$(defaults read com.apple.dock persistent-apps 2>/dev/null |
    grep -c '"tile-data"' || true)
  [[ "$actual" == "$want" ]] || fail "Dock has $actual pinned apps, expected $want"
}

verify_space_hotkeys() {
  local id actual
  while IFS=: read -r id _; do
    [[ -z "$id" ]] && continue
    actual=$(defaults export "$symbolichotkeys_domain" - 2>/dev/null |
      plutil -extract "AppleSymbolicHotKeys.$id.enabled" raw -o - - 2>/dev/null)
    [[ "$actual" == false || "$actual" == 0 ]] ||
      fail "symbolic hotkey $id enabled is '$actual', expected false"
  done <<<"$space_hotkeys"
}

verify_system() {
  local displaysleep
  sudo grep -q pam_tid "$pam_sudo_local" 2>/dev/null ||
    fail "pam_tid missing from $pam_sudo_local"

  displaysleep=$(pmset -g custom 2>/dev/null | awk '/displaysleep/ { print $2; exit }')
  [[ "$displaysleep" == 30 ]] ||
    fail "pmset displaysleep is '$displaysleep', expected 30"
}

# ─────────────────────────────── restart ───────────────────────────────

should_restart() {
  local answer
  case "${MACOS_INIT_RESTART:-}" in
    1 | true | yes) return 0 ;;
    0 | false | no) return 1 ;;
  esac
  [[ -t 0 ]] || return 0
  read -r -p "Restart Dock, Finder, ControlCenter and SystemUIServer now? [Y/n] " answer
  [[ ! "$answer" =~ ^[Nn] ]]
}

restart_services() {
  local activate=/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings
  [[ -x "$activate" ]] && "$activate" -u
  killall Dock Finder ControlCenter SystemUIServer 2>/dev/null || true
  echo "Restarted. Keyboard and trackpad changes take full effect after the next login."
}

# ──────────────────────────────── main ────────────────────────────────

echo "Requesting administrator access for PAM and power settings..."
sudo -v || warn "could not obtain sudo; PAM and power settings skipped"

apply_defaults
apply_dock_apps
apply_space_hotkeys
if sudo -n true 2>/dev/null; then
  apply_touchid_sudo
  apply_power
fi

echo ""
if should_restart; then
  restart_services
else
  echo "Skipped restart. Run 'killall Dock Finder ControlCenter SystemUIServer' to apply."
fi

echo ""
echo "Verifying..."
verify_defaults
verify_dock_apps
verify_space_hotkeys
sudo -n true 2>/dev/null && verify_system

echo ""
if ((${#failures[@]} == 0)); then
  echo "=========================================="
  echo "All settings verified."
  echo "=========================================="
else
  echo "=========================================="
  echo "${#failures[@]} setting(s) did not apply:"
  printf '  - %s\n' "${failures[@]}"
  echo "=========================================="
  exit 1
fi
