#!/usr/bin/env bash

# cda - change directory across all tmux panes in the current window
current_dir=$(tmux display-message -p '#{pane_current_path}')

window_index=$(tmux display-message -p '#I')

tmux list-panes -F '#{pane_index} #{pane_current_command} #{@nvim_server}' | while read -r pane_index pane_command nvim_server; do
  if [ "$pane_index" != "$(tmux display-message -p '#{pane_index}')" ]; then
    if [[ "$pane_command" =~ zsh ]]; then
      tmux send-keys -t "$window_index.$pane_index" "cd \"$current_dir\"" C-m
    elif [[ "$pane_command" == nvim && -n "$nvim_server" ]]; then
      # @nvim_server is set by nvim's autocmds.lua; ' is doubled for the Vim string.
      nvim --server "$nvim_server" --remote-expr "execute('cd ' .. fnameescape('${current_dir//\'/\'\'}'))" >/dev/null
    else
      echo "Skipping pane $pane_index (running $pane_command)"
    fi
  fi
done
