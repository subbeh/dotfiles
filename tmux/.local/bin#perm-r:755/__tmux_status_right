#!/usr/bin/env bash

statemate=$(__statemate_status tmux)
am=$(__am_status tmux)

parts=()
[[ -n "$statemate" ]] && parts+=("$statemate")
[[ -n "$am" ]] && parts+=("$am")

sep=" #[fg=colour243]⏽#[fg=default] "
result=""
for part in "${parts[@]}"; do
  [[ -n "$result" ]] && result+="$sep"
  result+="$part"
done
echo "$result"
