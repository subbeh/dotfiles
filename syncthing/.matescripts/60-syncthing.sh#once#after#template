#!/usr/bin/env bash

set -euo pipefail

read -r -n 1 -p "Set up Syncthing? [Y/n] " reply </dev/tty || reply=""
echo
if [[ "${reply:-Y}" == [Yy]* ]]; then
  systemctl --user enable --now syncthing.service
  sleep 2

  echo ""
  echo "=========================================="
  echo "This device's Syncthing ID:"
  syncthing device-id
  echo "=========================================="
  echo ""
  echo "Web GUI: http://127.0.0.1:8384"
fi
