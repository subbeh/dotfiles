#!/usr/bin/env bash
# description: Enable and start Syncthing service

set -euo pipefail

systemctl --user enable --now syncthing.service
sleep 2

echo ""
echo "=========================================="
echo "This device's Syncthing ID:"
syncthing device-id
echo "=========================================="
echo ""
echo "Web GUI: http://127.0.0.1:8384"
