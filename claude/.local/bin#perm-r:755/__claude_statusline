#!/usr/bin/env bash
# Claude Code status line, styled to match the starship prompt defined in
# ~/.config/starship/config.toml: the same directory icon substitutions in
# bold bright-blue, a bold purple ❯ separator, and secondary info in dimmed
# white like starship's right_format.

input=$(cat)

# One jq call, \x1f-delimited. Not tab/space: bash `read` collapses runs of IFS
# whitespace regardless of IFS, so an empty field would shift every later field
# left by one. \x1f is not IFS whitespace, so empty fields survive.
IFS=$'\x1f' read -r cwd model model_id effort in_tok out_tok win cost \
  five_h seven_d five_h_reset seven_d_reset < <(
  jq -r '
  # resets_at as epoch seconds or ISO 8601, shown in local time
  def reset($fmt): if . == null then "" else (if type == "number" then . else sub("\\.[0-9]+"; "") | fromdateiso8601 end | localtime | strftime($fmt)) end;
  [
    (.workspace.current_dir // .cwd // ""),
    (.model.display_name // ""),
    (.model.id // ""),
    (.effort.level // ""),
    (.context_window.total_input_tokens // 0),
    (.context_window.total_output_tokens // 0),
    (.context_window.context_window_size // 0),
    (.cost.total_cost_usd // 0),
    (.rate_limits.five_hour.used_percentage // ""),
    (.rate_limits.seven_day.used_percentage // ""),
    (.rate_limits.five_hour.resets_at | reset("%H:%M")),
    (.rate_limits.seven_day.resets_at | reset("%a %H:%M"))
  ] | map(tostring) | join("")' <<<"$input"
)

blue=$'\033[1;94m'
cyan=$'\033[1;36m'
green=$'\033[32m'
dim=$'\033[2;37m'
purple=$'\033[1;35m'
red=$'\033[1;31m'
yellow=$'\033[1;33m'
reset=$'\033[0m'

# Mirror the [directory].substitutions table from config.toml. '#' is the sed
# delimiter rather than '|', which would clash with the alternation in
# (/data|/Users/Shared/data) and abort with "parentheses not balanced".
#
# Order matters and matches starship: the ~/.config rules run before the bare
# ~/ rule, so once a prefix is rewritten the later rules no longer match.
path=${cwd/#$HOME/\~}
path=$(sed -E \
  -e 's#^~/\.config$#[]#' \
  -e 's#^~/\.config/#[] #' \
  -e 's#^~$#[]#' \
  -e 's#^~/#[] #' \
  -e 's#^(/data|/Users/Shared/data)#<data>#' \
  -e 's#^<data>/workspace/dotfiles$#[󰇘]#' \
  -e 's#^<data>/workspace/dotfiles/#[󰇘] #' \
  -e 's#^<data>/workspace$#[󱧽]#' \
  -e 's#^<data>/workspace/#[󱧽] #' \
  -e 's#^<data>$#[]#' \
  -e 's#^<data>/#[] #' <<<"$path")

# Context: meter input+output against the window. Claude Code can report a 200k
# window for a native-1M model whose provider path is not flagged for 1M (this
# account's id carries a [1m] suffix), which would peg the meter at 100% while
# the session happily continues -- so trust the suffix over the reported size.
total=$(( ${in_tok:-0} + ${out_tok:-0} ))
eff_win=${win:-0}
(( eff_win <= 0 )) && eff_win=200000
[[ $model_id == *"[1m]"* || $model_id == *"[1M]"* ]] && (( eff_win < 1000000 )) && eff_win=1000000
pct=$(awk -v t="$total" -v w="$eff_win" \
  'BEGIN{p=int(t/w*100+0.5); if(p>100)p=100; if(p<0)p=0; print p}')

# --no-optional-locks keeps a status line render from taking the index lock and
# fighting with an interactive git command in the same repo. The empty guard
# matters because `git -C ""` silently falls back to the process cwd, which would
# report an unrelated repo's branch.
branch="" oid="" ahead=0 behind=0 staged=0 modified=0 untracked=0 conflicts=0
if [[ -n $cwd ]]; then
  while IFS= read -r line; do
    case $line in
      '# branch.oid '*) oid=${line#'# branch.oid '} ;;
      '# branch.head '*) branch=${line#'# branch.head '} ;;
      '# branch.ab '*) read -r _ _ ahead behind <<<"$line"; ahead=${ahead#+}; behind=${behind#-} ;;
      [12]' '*)
        [[ ${line:2:1} != . ]] && ((++staged))
        [[ ${line:3:1} != . ]] && ((++modified)) ;;
      'u '*) ((++conflicts)) ;;
      '? '*) ((++untracked)) ;;
    esac
  done < <(git --no-optional-locks -C "$cwd" status --porcelain=v2 --branch 2>/dev/null)
fi
[[ $branch == "(detached)" ]] && branch=${oid:0:7}

# Symbols match gitmux's defaults in the tmux bar.
git_status=""
((ahead)) && git_status+=" ↑$ahead"
((behind)) && git_status+=" ↓$behind"
((staged)) && git_status+=" ●$staged"
((modified)) && git_status+=" ✚$modified"
((untracked)) && git_status+=" …$untracked"
((conflicts)) && git_status+=" ✖$conflicts"

# Profile from the active config dir (~/.claude.<profile>).
profile=$(basename "${CLAUDE_CONFIG_DIR:-}")
profile=${profile#.claude}
profile=${profile#.}
case $profile in
  work) profile_color=$red ;;
  personal) profile_color=$blue ;;
  *) profile_color=$yellow ;;
esac

# Personal shares one config dir across cswap accounts: show the active one's
# alias (else the email's local part). Falls back to "personal" on any failure.
label=$profile
if [[ $profile == personal ]]; then
  acct=$(jq -r --slurpfile c "${CLAUDE_CONFIG_DIR}/.claude.json" '
    ($c[0].oauthAccount.emailAddress // empty) as $e
    | [.accounts[] | select(.email == $e)][0] | (.alias // (.email | split("@")[0])) // empty
  ' "${XDG_DATA_HOME:-$HOME/.local/share}/claude-swap/sequence.json" 2>/dev/null)
  [[ -n $acct ]] && label=$acct
fi

# Usage: a subscription (Max) reports its 5h/7d rate-limit windows, which make
# the list-price cost meaningless; API billing (Bedrock) has no windows, so the
# cost is the usage figure. The windows only arrive after the first response.
# Each window: a 5-cell bar coloured by how much is used, the %, and its reset.
meter() {
  # Nerd Font progress glyphs (U+EE00-EE05): start/middle/end, empty then filled
  local p color bar="" i empty=("" "" "") full=("" "" "") pos
  p=$(printf '%.0f' "$2")
  if ((p >= 80)); then color=$red; elif ((p >= 50)); then color=$yellow; else color=$green; fi
  for i in 1 2 3 4 5; do
    pos=$(( i == 1 ? 0 : i == 5 ? 2 : 1 ))
    if ((p >= i * 20 - 10)); then bar+=${full[pos]}; else bar+=${empty[pos]}; fi
  done
  # reset first: the surrounding dim would otherwise dim the bar too
  printf '%s %s%s%s %s%%%s' "$1" "$reset$color" "$bar" "$reset$dim" "$p" "${3:+  $3}"
}
usage=""
[[ -n $five_h ]] && usage+=$(meter 5h "$five_h" "$five_h_reset")
[[ -n $seven_d ]] && usage+="${usage:+ • }$(meter 7d "$seven_d" "$seven_d_reset")"

# The waybar claude module reads the latest windows from here; personal only.
if [[ $profile == personal && -n $five_h ]]; then
  cache=${XDG_STATE_HOME:-$HOME/.local/state}/claude
  { mkdir -p "$cache" &&
    jq -c '.rate_limits' <<<"$input" >"$cache/usage.json.$$" &&
    mv "$cache/usage.json.$$" "$cache/usage.json"; } 2>/dev/null
fi

out=""
[[ -n $label ]] && out+="${profile_color}${label}${reset} "
out+="${blue}${path}${reset} ${purple}❯${reset}"
[[ -n $model ]] && out+=" ${dim}${model}${effort:+ ($effort)}${reset}"
(( total > 0 )) && out+=" ${dim}• $((total / 1000))k (${pct}%)${reset}"
if [[ -n $usage ]]; then
  out+=" ${dim}• ${usage}${reset}"
elif [[ -n $cost ]]; then
  out+=" ${dim}•${reset} ${green}\$$(printf '%.2f' "$cost")${reset}"
fi
[[ -n $branch ]] && out+=" ${dim}•${reset} ${cyan}${reset} ${dim}${branch}${git_status}${reset}"

printf '%s\n' "$out"
