#!/bin/bash
# Update every installed Claude Code plugin through the claude CLI.
# The CLI can't say what is outdated before updating, so all plugins are updated.
# A marketplace-declared command that needs confirmation is reported, never accepted.

set -euo pipefail

for cmd in jq claude; do
  command -v "$cmd" &>/dev/null || {
    echo "Error: $cmd is required but not installed." >&2
    exit 1
  }
done

echo "Updating marketplaces..."
claude plugin marketplace update </dev/null || echo "Warning: marketplace update failed, results may be stale" >&2

updated=0 current=0 failed=0
while IFS= read -r id; do
  [[ -z "$id" ]] && continue
  # stdin from /dev/null so a confirmation prompt can't hang an unattended run
  if ! out=$(claude plugin update "$id" --json </dev/null 2>&1); then
    # shortcut: a failure's JSON shape is unverified, show the CLI's raw output
    echo "✗ $id: $(jq -r '.message // empty' <<<"$out" 2>/dev/null || true)${out:+ }$(jq -e . <<<"$out" &>/dev/null || echo "$out")"
    ((++failed))
    continue
  fi
  case "$(jq -r '.updateOutcome // .outcome' <<<"$out")" in
  up_to_date)
    echo "= $id $(jq -r .newVersion <<<"$out")"
    ((++current))
    ;;
  *)
    echo "↑ $id $(jq -r '"\(.oldVersion) → \(.newVersion)"' <<<"$out")"
    ((++updated))
    ;;
  esac
done < <(claude plugin list --json </dev/null | jq -r '.[].id')

echo "$updated updated, $current current, $failed failed (restart Claude Code to apply)"
