#!/usr/bin/env bash
# description: Update Claude Code plugins and skills
# tags: update

command -v npx &>/dev/null || exit 0

# Both honour CLAUDE_CONFIG_DIR, so run them once per profile config dir
# (the -d check skips ~/.claude.json and an unmatched glob)
for dir in "$HOME"/.claude.*; do
  [[ -d "$dir" ]] || continue
  export CLAUDE_CONFIG_DIR="$dir"
  echo "==> $dir"

  # No stdin: update every outdated plugin without prompting
  claude-update-plugins </dev/null || true

  npx skills update -g
done
