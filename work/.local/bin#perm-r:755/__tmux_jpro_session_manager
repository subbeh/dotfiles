#!/bin/bash
set -euo pipefail

SESH="work"
DIR="${JAMF_DIR:?not set}"
LOG="${XDG_CACHE_HOME:?not set}/tmux/jamf_session.log"

test -d "${LOG%/*}" || mkdir -p "$_"

# List sessions, most recently used first (reusable for fzf reload)
list_sessions() {
  ls -td "${DIR:?not set}/sessions/"*/ 2>/dev/null | sed 's|.*/\([^/]*\)/$|\1|' || true
}

exec 2>>"$LOG"

# Subcommands called back from the fzf bindings; they share the picker's
# terminal, so prompts go to /dev/tty instead of stderr.
case "${1:-}" in
--list)
  list_sessions
  exit 0
  ;;
--delete)
  session_name="${2:?no session given}"
  session_dir="${DIR}/sessions/${session_name}"

  printf '\nDelete session "%s"? [y/N] ' "$session_name" >/dev/tty
  read -r confirm </dev/tty
  [[ "$confirm" =~ ^[Yy]$ ]] || exit 0

  tmux kill-window -t "$SESH:$session_name" 2>/dev/null || true
  rm -rf "$session_dir"
  exit 0
  ;;
esac

exec 2>"$LOG"

if ! tmux has-session -t "${SESH:?not set}" 2>/dev/null; then
  tmuxinator start "$SESH" --no-attach
fi

if [[ -z "${1:-}" ]]; then
  instance=$(
    list_sessions | fzf \
      --bind=enter:print-query,tab:accept \
      --bind="ctrl-d:execute($0 --delete {})+reload($0 --list)" \
      --reverse \
      --header "existing sessions (tab=select, ctrl-d=delete):" \
      --tmux center,20% || exit 0
  )
else
  instance="$1"
fi

if [[ "$instance" ]]; then
  session_dir="${DIR}/sessions/$instance"

  if ! tmux list-windows -t "$SESH":"$instance" &>/dev/null; then
    test -d "$session_dir" || mkdir -p "$session_dir"/{logs,data}
    echo 'export KUBECONFIG="$(expand_path ./kubeconfig)"' >"$session_dir/.envrc"
    echo "export INST=$instance" >>"$session_dir/.envrc"
    # echo 'export K9S_CONFIG_DIR=$HOME/.config/k9s/work' >>"$session_dir/.envrc"
    direnv allow "$session_dir"
    tmux new-window -t "$SESH": -n "$instance" -c "$session_dir"

    # Mark as jpro window and initialize status
    tmux setw -t "$SESH:$instance" @jpro_window "true"
    tmux setw -t "$SESH:$instance" @jpro_status ""

    # Trigger initial status update
    ~/.local/bin/__tmux_jpro_status_update "$SESH:$instance" "$instance"

    # select window
    tmux switchc -t "$SESH"
    tmux select-window -t "$SESH":"$instance"

    # create layout
    tmux split-window -h -p 35 -c "$session_dir"
    tmux split-window -v -t 1 -c "$session_dir"
    tmux select-pane -t 1

    # enable logging
    tmux pipe-pane -t '{bottom-left}' "cat >> ${session_dir}/logs/pane_2.log"

    # set context and run clops tools
    tmux send-keys -t '{top-left}' "__jpro_set_ctx $instance ; k9s -n $instance-jamfcloud-com -c po" C-m
    tmux send-keys -t '{top-right}' "cd $DIR/cloud-ops-tools/src/scripts && ./jtop.py -i $instance" C-m

    # bind key for sketchybar context
    # tmux bind-key -T prefix C "run-shell 'KUBECONFIG=${JAMF_DIR:?not set}/kubeconfig hermes jpro set-ctx #{window_name} && open swiftbar://refreshplugin?name=hermes'"
    tmux bind-key -T prefix C "run-shell -b '$HOME/.config/clopsbar/plugins/hermes.10s.sh set_context #{window_name}'"
  else
    # select window
    tmux switchc -t "$SESH"
    tmux select-window -t "$SESH":"$instance"
  fi
fi
