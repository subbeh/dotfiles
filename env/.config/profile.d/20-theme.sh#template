#!/bin/sh

BASE16_COLOR_00_HEX=${BASE16_COLOR_00_HEX:-{{ .Vars.color.black.base }}}
BASE16_COLOR_01_HEX=${BASE16_COLOR_01_HEX:-{{ .Vars.color.red.base }}}
BASE16_COLOR_02_HEX=${BASE16_COLOR_02_HEX:-{{ .Vars.color.green.base }}}
BASE16_COLOR_03_HEX=${BASE16_COLOR_03_HEX:-{{ .Vars.color.yellow.base }}}
BASE16_COLOR_04_HEX=${BASE16_COLOR_04_HEX:-{{ .Vars.color.blue.base }}}
BASE16_COLOR_05_HEX=${BASE16_COLOR_05_HEX:-{{ .Vars.color.magenta.base }}}
BASE16_COLOR_06_HEX=${BASE16_COLOR_06_HEX:-{{ .Vars.color.cyan.base }}}
BASE16_COLOR_07_HEX=${BASE16_COLOR_07_HEX:-{{ .Vars.color.white.base }}}
BASE16_COLOR_08_HEX=${BASE16_COLOR_08_HEX:-{{ .Vars.color.black.bright }}}
BASE16_COLOR_09_HEX=${BASE16_COLOR_09_HEX:-{{ .Vars.color.red.bright }}}
BASE16_COLOR_0A_HEX=${BASE16_COLOR_0A_HEX:-{{ .Vars.color.green.bright }}}
BASE16_COLOR_0B_HEX=${BASE16_COLOR_0B_HEX:-{{ .Vars.color.yellow.bright }}}
BASE16_COLOR_0C_HEX=${BASE16_COLOR_0C_HEX:-{{ .Vars.color.blue.bright }}}
BASE16_COLOR_0D_HEX=${BASE16_COLOR_0D_HEX:-{{ .Vars.color.magenta.bright }}}
BASE16_COLOR_0E_HEX=${BASE16_COLOR_0E_HEX:-{{ .Vars.color.cyan.bright }}}
BASE16_COLOR_0F_HEX=${BASE16_COLOR_0F_HEX:-{{ .Vars.color.white.bright }}}

export BASE16_COLOR_00_HEX BASE16_COLOR_01_HEX BASE16_COLOR_02_HEX BASE16_COLOR_03_HEX \
  BASE16_COLOR_04_HEX BASE16_COLOR_05_HEX BASE16_COLOR_06_HEX BASE16_COLOR_07_HEX \
  BASE16_COLOR_08_HEX BASE16_COLOR_09_HEX BASE16_COLOR_0A_HEX BASE16_COLOR_0B_HEX \
  BASE16_COLOR_0C_HEX BASE16_COLOR_0D_HEX BASE16_COLOR_0E_HEX BASE16_COLOR_0F_HEX

# Vivid
export BASE16_THEME_DEFAULT="${XDG_CONFIG_HOME}/vivid/theme.yml"
if [ -f "$BASE16_THEME_DEFAULT" ] && chkcmd vivid; then
  LS_COLORS="$(vivid generate "$BASE16_THEME_DEFAULT" 2>/dev/null)"
  export LS_COLORS
fi
