#!/usr/bin/env bash
# description: Install/update Neovim plugins
# tags: update

set -euo pipefail

echo "Setting environment..."
source $(find "${0%/*}/../.config/profile.d" -name "*.sh")

echo "Installing plugins..."
nvim --headless -c ':lua vim.pack.update(nil, { force = true })' -c qa
echo

echo "Cleaning inactive plugins..."
nvim --headless -c ':lua vim.pack.clean(nil, { inactive = true })' -c qa

echo "Building blink.cmp..."
nvim --headless -c 'lua if not require("blink.cmp").build():pwait() then vim.cmd.cquit() end' -c qa
echo

echo "Updating Treesitter languages..."
nvim --headless -c ':TSUpdate' -c qa
echo

echo "Updating Mason packages..."
nvim --headless -c ':MasonUpdate' -c qa
nvim --headless -c 'autocmd User MasonUpdateAllComplete qa' -c 'MasonUpdateAll'
