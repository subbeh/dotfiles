#!/bin/sh

if [ -d "$1" ]; then
  tree -CL 3 -a --gitignore --noreport "$1" 2>/dev/null && exit 0
fi

case "${1##*.}" in
md | MD | mkd | markdown)
  # glow drops styling when stdout isn't a TTY (as here, piped into less), so
  # force a style; -w 0 disables wrapping so less does it, matching bat below
  glow -s dark -w 0 "$1"
  ;;
*)
  [ "$(tput colors)" -gt 8 ] || exit 1
  # Leave binaries (and empty files) to less
  grep -qI . "$1" || exit 1
  # Keep less's direct file access (instant G, accurate %) on large files
  [ "$(wc -c <"$1")" -gt $((5 * 1024 * 1024)) ] && exit 1
  # --wrap=never so less does the wrapping, not bat
  bat --color=always --style=plain --paging=never --wrap=never "$1"
  ;;
esac
