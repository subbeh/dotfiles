# XDG Home
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}
XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg}

# Extensions
XDG_SRC_HOME=${XDG_SRC_HOME:-$HOME/.local/src}
XDG_BIN_HOME=${XDG_BIN_HOME:-$HOME/.local/bin}

{{ if eq .OS "linux" -}}
XDG_DATA_DIR=/data
{{ else if eq .OS "darwin" -}}
XDG_DATA_DIR=/Users/Shared/data
{{ end }}

# XDG Dirs
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-$TMPDIR}
XDG_WORKSPACE_DIR=${XDG_DATA_DIR:-$HOME}/workspace
XDG_TEMP_DIR=${XDG_DATA_DIR:-$HOME}/temp

XDG_APPDATA_DIR=${XDG_DATA_DIR:-$HOME}/appdata
XDG_DESKTOP_DIR=${XDG_TEMP_DIR}
XDG_DOCUMENTS_DIR=${XDG_TEMP_DIR}
XDG_DOWNLOAD_DIR=${XDG_TEMP_DIR}
XDG_MUSIC_DIR=${XDG_TEMP_DIR}
XDG_NOTES_DIR=${XDG_WORKSPACE_DIR}/notes
XDG_PICTURES_DIR=${XDG_TEMP_DIR}
XDG_PROJECTS_DIR=${XDG_WORKSPACE_DIR}/projects
XDG_PUBLICSHARE_DIR=${XDG_TEMP_DIR}
XDG_REPOS_DIR=${XDG_WORKSPACE_DIR}/repos
XDG_TEMPLATES_DIR=${XDG_TEMP_DIR}
XDG_VIDEOS_DIR=${XDG_TEMP_DIR}
