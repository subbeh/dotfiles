#!/bin/sh

{{ if eq .OS "darwin" -}}
export PROFILE_OS=darwin

set -o allexport
for file in "$HOME"/.config/environment.d/*.conf; do
  source "$file"
done
set +o allexport
{{ else if eq .OS "linux" -}}
export PROFILE_OS=linux
{{ else -}}
export PROFILE_OS=unknown
{{ end }}

command -v run0 >/dev/null 2>&1 && SU_CMD=run0
export SU_CMD="${SU_CMD:-sudo}"
