[global]
    follow = mouse
    origin = top-right
    offset = (15, 15)
    width = 350
    notification_limit = 5
    hide_duplicate_count = true
    show_indicators = false
    font = FiraMono Nerd Font Mono 9
    markup = full
    format = "<b><i>%s</i></b>\n<span line_height='1.45'>%b</span>"
    icon_position = left
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita, hicolor"
    frame_width = 2
    padding = 10
    horizontal_padding = 10
    gap_size = 5
    corner_radius = 0
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#{{ .Vars.color.bg.dark }}"
    foreground = "#{{ .Vars.color.fg.darker }}"
    frame_color = "#{{ .Vars.color.bg.lighter }}"
    timeout = 5

[urgency_normal]
    background = "#{{ .Vars.color.bg.dark }}"
    foreground = "#{{ .Vars.color.fg.default }}"
    frame_color = "#{{ .Vars.color.blue.bright }}"
    timeout = 5

[urgency_critical]
    background = "#{{ .Vars.color.bg.dark }}"
    foreground = "#{{ .Vars.color.red.bright }}"
    frame_color = "#{{ .Vars.color.red.bright }}"
    timeout = 0

# Glyph rules: later sections win, so urgency glyphs come first, then per-app glyphs.
# Urgency glyphs only apply to notifications without an image of their own.
[glyph_low]
    msg_urgency = low
    icon_position = off
    format = "<span size='250%%' rise='-4096' line_height='0.5' foreground='#{{ .Vars.color.fg.darker }}'></span>  <b><i>%s</i></b>\n<span line_height='1.45'>%b</span>"

[glyph_normal]
    msg_urgency = normal
    icon_position = off
    format = "<span size='250%%' rise='-4096' line_height='0.5' foreground='#{{ .Vars.color.blue.bright }}'></span>  <b><i>%s</i></b>\n<span line_height='1.45'>%b</span>"

[glyph_critical]
    msg_urgency = critical
    icon_position = off
    format = "<span size='250%%' rise='-4096' line_height='0.5' foreground='#{{ .Vars.color.red.bright }}'></span>  <b><i>%s</i></b>\n<span line_height='1.45'>%b</span>"

# Undo the urgency glyph where the app sent its own icon.
[keep_icon]
    icon = "?*"
    icon_position = left
    format = "<b><i>%s</i></b>\n<span line_height='1.45'>%b</span>"

