#!/usr/bin/env bash

# Simple script to cycle through audio outputs
# Usage: __waybar_cycle_sink [next|prev]

get_default_sink_id() {
    wpctl status | awk '/Sinks:/,/Sources:/' | grep '\*' | sed 's/^[^0-9]*//' | awk '{print $1}' | tr -d '.' | head -1
}

list_sink_ids() {
    wpctl status | awk '/Sinks:/,/Sources:/' | grep -E '^\s*[│├└]\s*\*?\s*[0-9]+\.' | sed 's/^[^0-9]*//' | awk '{print $1}' | tr -d '.'
}

# $1 is the step: 1 for next, -1 for prev
cycle() {
    local step=$1 current_id
    current_id=$(get_default_sink_id)

    local -a sink_ids
    while IFS= read -r id; do
        [[ -n "$id" ]] && sink_ids+=("$id")
    done <<< "$(list_sink_ids)"

    local count=${#sink_ids[@]}
    [[ $count -le 1 ]] && return

    local current_index=-1
    for i in "${!sink_ids[@]}"; do
        if [[ "${sink_ids[$i]}" == "$current_id" ]]; then
            current_index=$i
            break
        fi
    done

    # wpctl accepts an unavailable sink (an HDMI port with no display) without
    # making it the default, so try each sink in turn until one sticks
    local n candidate
    for ((n = 1; n < count; n++)); do
        candidate=${sink_ids[$(( (current_index + step * n + count * count) % count ))]}
        wpctl set-default "$candidate"
        [[ "$(get_default_sink_id)" == "$candidate" ]] && return
    done
}

case "${1:-next}" in
    prev)
        cycle -1
        ;;
    *)
        cycle 1
        ;;
esac
