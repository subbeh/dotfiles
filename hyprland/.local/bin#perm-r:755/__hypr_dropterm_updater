#!/usr/bin/env bash

shown() {
  hyprctl clients -j | jq -e 'any(.[]; .class == "dropterm" and .workspace.name != "special:dropterm")' >/dev/null
}

focused() {
  hyprctl activewindow -j | jq -e '.class == "dropterm"' >/dev/null
}

# hyprctl eval prints "ok" on success, which would land under the update output
dispatch() {
  local out
  out=$(hyprctl eval "hl.dispatch($1)") || echo "$out" >&2
}

# after <status>: back to window 1 and hide on success, bring the error into view on failure.
# Dropterm() hides whenever dropterm is shown, so a shown but unfocused dropterm only gets focus.
if [[ $1 == after ]]; then
  if (($2 == 0)); then
    tmux select-window -t dropterm:1
    focused && dispatch 'Dropterm()'
  elif ! shown; then
    dispatch 'Dropterm()'
  elif ! focused; then
    dispatch 'hl.dsp.focus({ window = "class:^dropterm$" })'
  fi
  exit 0
fi

# open dropterm
hyprctl eval 'hl.dispatch(Dropterm())'
while ! tmux list-sessions -F \#S | grep -q dropterm; do sleep 0; done
tmux set-option -t dropterm monitor-activity off

# create window; the trailing colon targets the session, since bare "dropterm" matches window dropterm:1
tmux list-windows -t dropterm | grep -q updates || tmux new-window -t dropterm: -n updates

# select window
tmux select-window -t dropterm:updates

# a lock with no pacman/paru running is stale: clear it instead of updating
if [[ -e /var/lib/pacman/db.lck ]] && ! pgrep -x 'pacman|paru' &>/dev/null; then
  cmd='sudo rm -f /var/lib/pacman/db.lck && pkill -SIGRTMIN+8 waybar'
else
  cmd='paru -Syu --noconfirm && pkill -SIGRTMIN+8 waybar'
fi

# one line: sudo's pty relay swallows any typeahead queued behind paru
pgrep paru || tmux send-keys -t dropterm:updates "clear; $cmd; __hypr_dropterm_updater after "'$?' Enter
