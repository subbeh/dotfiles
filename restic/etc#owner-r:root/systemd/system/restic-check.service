[Unit]
Description=restic repository integrity check
Documentation=https://restic.readthedocs.io/en/stable/045_working_with_repos.html
Wants=network-online.target
After=network-online.target
OnFailure=restic-failure@%n.service
; ConditionACPower=true

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/env
CacheDirectory=restic
TimeoutStartSec=infinity

Nice=19
IOSchedulingClass=idle

# network-online.target is only reached at boot and never deactivated, so it is
# already active on resume from sleep -- where a Persistent= timer fires before
# NetworkManager has reconnected. Wait for connectivity for real.
ExecStartPre=/usr/bin/nm-online -q -t 120

# Remove stale locks from interrupted backups (e.g., laptop shutdown)
ExecStartPre=/usr/bin/restic unlock

# Verifies all metadata plus a 5% sample of pack data, so a silently corrupted
# repository surfaces here rather than at restore time.
ExecStart=/usr/bin/restic check --read-data-subset=5%%

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
