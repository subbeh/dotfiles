nnoremap S :sort<cr>
" Open file in background with default program
nnoremap gb :file &<cr>l

" Tab management (<space>t prefix)
" Create new tab
nnoremap <space>tc :tabnew<cr>
" Previous tab
nnoremap <space>tp :tabprevious<cr>
" Next tab
nnoremap <space>tn :tabnext<cr>
" Close tab
nnoremap <space>tx :tabclose<cr>

" Window management (<space>w prefix for <c-w> operations)
