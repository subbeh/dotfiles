" ------------------------------------------------------------------------------
" Clipboard integration
" ------------------------------------------------------------------------------

if $WAYLAND_DISPLAY != ''
    if executable('wl-copy')
        " Yank directory path (Wayland)
        nnoremap yd :!echo -n %d | wl-copy %i &&
                    \ echo -n %d | wl-copy -p %i<cr>
        " Yank file path (Wayland)
        nnoremap yf :!echo -n %c:p | wl-copy %i &&
                    \ echo -n %c:p | wl-copy -p %i<cr>
    endif
elseif $DISPLAY != ''
    if executable('xclip')
        " Yank directory path (xclip)
        nnoremap yd :!echo -n %d | xclip -selection clipboard %i<cr>
        " Yank file path (xclip)
        nnoremap yf :!echo -n %c:p | xclip -selection clipboard %i<cr>
    elseif executable('xsel')
        " Yank directory path (xsel)
        nnoremap yd :!echo -n %d | xsel --input --primary %i &&
                    \ echo -n %d | xsel --clipboard --input %i<cr>
        " Yank file path (xsel)
        nnoremap yf :!echo -n %c:p | xsel --input --primary %i &&
                    \ echo -n %c:p | xsel --clipboard --input %i<cr>
    endif
endif

" ------------------------------------------------------------------------------
" File/directory creation
" ------------------------------------------------------------------------------

" Smart create: trailing slash = directory, otherwise file
command create :
\|  let $last_char = expand(system("str=\"%a\"; echo \"${str: -1}\""))
\|  if $last_char == "/"
\|    execute '!mkdir -p "%a"'
\|  else
\|    touch "%a"
\|  endif

" Create file or directory
nnoremap a :create<space>

" ------------------------------------------------------------------------------
" Misc
" ------------------------------------------------------------------------------

" Grep configuration
if executable('rg')
    " Use ripgrep if available
    set grepprg='rg --line-number --no-messages %i %a %s'
else
    " Fallback to grep (suppress permission errors)
    set grepprg="grep -n -H -I -r -s %i %a %s"
    if system("find --version | grep -c 'GNU findutils'") != 0
        set findprg='find %s %a -print , -type d \( ! -readable -o ! -executable \) -prune'
    endif
endif

" ------------------------------------------------------------------------------
" Interactive pickers (fzf)
" ------------------------------------------------------------------------------
" Each picker stores the choice in $vifm_pick so an aborted fzf (empty output) is a
" no-op instead of an error from :goto / :cd.

" Pick a file with fd; arguments go to fd, e.g. `:Find -HI` for hidden+ignored
command! Find : let $vifm_pick = term('fd %a
            \ | fzf --preview "bat --color=always --style=numbers --line-range=:500 {}"')
            \| if $vifm_pick != '' | execute 'goto' fnameescape($vifm_pick) | endif

" Live grep: ripgrep re-runs on every keystroke, fzf previews the matched line
command! Grep : let $vifm_pick = term(
            \ 'RG="rg --column --line-number --no-heading --color=always --smart-case";' .
            \ ' fzf --ansi --disabled --delimiter : --prompt "Grep> "' .
            \ ' --bind "start:reload:$RG {q} || true"' .
            \ ' --bind "change:reload:sleep 0.1; $RG {q} || true"' .
            \ ' --preview "bat --color=always {1} --highlight-line {2}"' .
            \ ' --preview-window "up,60%%,border-bottom,+{2}+3/3,~3"' .
            \ ' | cut -d: -f1')
            \| if $vifm_pick != '' | execute 'goto' fnameescape($vifm_pick) | endif

" Jump to a frecent directory with zoxide
command! Zoxide : let $vifm_pick = term('zoxide query --interactive')
            \| if $vifm_pick != '' | execute 'cd' fnameescape($vifm_pick) | endif

" Feed zoxide (%i keeps it in the background so navigation doesn't flicker) and
" make its interactive picker behave like the ones above
let $_ZO_FZF_OPTS='--exact --no-sort --bind=ctrl-z:ignore,btab:up,tab:down --cycle --keep-right --info=default --layout=default --tabstop=1 --exit-0 --select-1'
autocmd DirEnter * !zoxide add %"d %i

" Activate screen/tmux support
screen!
