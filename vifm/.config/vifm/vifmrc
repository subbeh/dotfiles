nnoremap svd :set viewcolumns=<cr>
" Name only
nnoremap svD :set viewcolumns=-{name}<cr>
" Standard
nnoremap svs :set viewcolumns=-60%{name}...,10{size}.,5{nitems}.,{#\ },-16{mtime}..<cr>
